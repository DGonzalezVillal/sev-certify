[Unit]
Description=Fetch SNP Guest Attestation Status inside the guest
DefaultDependencies=no
After=snpguest-attestation.service
Wants=snpguest-attestation.service

[Service]
Type=oneshot
ExecStart=jq '.' /usr/local/lib/attestation_status
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5s
